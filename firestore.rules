rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId)   { return isAuthenticated() && request.auth.uid == userId; }
    function isDocOwner()      { return isAuthenticated() && request.auth.uid == resource.data.userId; }
    function isAdmin()         { return isAuthenticated() && request.auth.token.role == 'admin'; }

    function isValidUrl(url) {
      return url == null || (url is string && (url.matches("^https://.*") || url.matches("^http://.*")));
    }

    // ===============================================================
    // Users
    // ===============================================================

    match /users/{userId} {
      allow read:   if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ===============================================================
    // Posts
    // ===============================================================

    match /posts/{postId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isDocOwner();
      allow delete: if isDocOwner();

      match /comments/{commentId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ===============================================================
    // Post Likes  (FIX: was missing — caused "Missing or insufficient permissions")
    // ===============================================================

    match /postLikes/{likeId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===============================================================
    // Chats
    // ===============================================================

    match /chats/{chatId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() <= 2;

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string;
      }
    }

    // ===============================================================
    // Notifications
    // ===============================================================

    match /notifications/{notificationId} {
      allow read:   if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // ===============================================================
    // Reviews
    // ===============================================================

    match /reviews/{reviewId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // ===============================================================
    // Analytics
    // ===============================================================

    match /analytics_events/{eventId} {
      allow create: if isAuthenticated();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    match /analytics_daily/{dateId} {
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // Lynks
    // ===============================================================

    match /lynks/{lynkId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // FIX: allow any authenticated user to update likesCount / savesCount / etc.
      // Previously only the owner could update, which blocked like/save/view writes.
      allow update: if isAuthenticated() && (
        isDocOwner()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likesCount', 'savesCount', 'sharesCount', 'viewsCount',
                       'commentsCount', 'totalWatchSeconds', 'completionRate',
                       'isTrending', 'boostScore'])
      );

      allow delete: if isDocOwner();
    }

    // ===============================================================
    // Lynk sub-collections  (FIX: all missing — blocked every interaction)
    // ===============================================================

    match /lynkLikes/{likeId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /lynkSaves/{saveId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /lynkComments/{commentId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /lynkViews/{viewId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /watchTimeLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
    }

    match /lynkReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read:   if isAdmin();
    }

    // ===============================================================
    // Blinks (Stories)
    // ===============================================================

    match /blinks/{blinkId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.type in ['image', 'video']
        && request.resource.data.expiresAt is string
        && request.resource.data.viewsCount == 0
        && request.resource.data.viewedBy is list
        && request.resource.data.viewedBy.size() == 0;

      allow delete: if isDocOwner();

      allow update: if isAuthenticated() && (
        isDocOwner()
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewedBy', 'viewsCount'])
          && request.resource.data.viewedBy is list
          && request.resource.data.viewedBy.size() == resource.data.viewedBy.size() + 1
          && request.resource.data.viewedBy.hasAll(resource.data.viewedBy)
          && request.auth.uid in request.resource.data.viewedBy
          && !(request.auth.uid in resource.data.viewedBy)
          && request.resource.data.viewsCount == resource.data.viewsCount + 1
        )
      );

      match /reactions/{reactionId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      match /replies/{replyId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

  }
}
